# GEMINI_API_KEY: Optional if AI capabilities are requested
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# MySQL Database Connection (Optional in local development; auto-uses embedded engine if not set)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=portfolio_user
MYSQL_PASSWORD=your_secure_password
MYSQL_DATABASE=portfolio_db

